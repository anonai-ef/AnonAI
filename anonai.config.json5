// Devnet configuration (chain 1337, the public ERC-8421 alt-mempool devnet). Read-only for the code.
{
  chainId: 1337,
  gatewayUrl: "https://altmempoolgateway.forshtat.com/rpc",   // sidecar: eth_sendFrameTransaction, explorer, faucet
  ethrexUrl: "https://altmempool.forshtat.com",                // execution client: eth_* and eth_sendRawTransaction
  // The miner's own sidecar. Transactions are also submitted here when the gateway's gossip does not reach it
  // (observed after devnet restarts). Same public mempool, same rules; the hash is identical so nothing doubles.
  minerUrl: "https://altmempool.forshtat.com/rpc",
  explorerUrl: "https://explorer.altmempool.wtf/",
  stakingRegistry: "0xd51c04d7a0b01124e84de152f4e56d9eecb22d2f",
  recentRootAddress: "0x0000000000000000000000000000000000008272",
  nonceManager: "0x0000000000000000000000000000000000008250",
  usdc: "0xEFe0D421fD473564c9C9b0cDCeB194cF476D6AF5",          // predeployed real USDC bytecode (6 decimals); its deployer key is off limits
  weth: "0x1b7d32025F7cA633943BbCC9Ec61a98ef66187b6",          // predeployed canonical WETH9: the demo pays in WETH (anyone can wrap)
  deterministicProxy: "0x4e59b44847b379578588920ca78fbf26c0b4956c", // Arachnid's CREATE2 proxy, in genesis
  poseidonT3: "0x3333333C0A88F9BE4fd23ed0536F9B6c427e3B93",    // poseidon-solidity's PoseidonT3 via the proxy (Keystore's LeanIMT hash)
  stateFile: ".anonai-state.json",
  maxFeePerGasGwei: "2",
  legacyGasPriceGwei: "0.002",
  deployGasLimit: 6000000,
  // Ceiling for estimated gas. Code deposits pay state gas on this devnet (PoseidonT3 estimates at ~38M); blocks allow 60M.
  heavyDeployGasLimit: 55000000,
  stakeEth: "0.012",
  unstakeDelaySec: 86400,
  // creation values: the account needs its stake plus margin, the paymaster a float to pay gas from
  accountFundingEth: "0.03",
  paymasterFundingEth: "0.05",
  // Keystore heartbeat spacing in blocks (6 s each): a new epoch at most every 30 s
  epochBlocks: 5,
  txTimeoutSec: 120,
}
